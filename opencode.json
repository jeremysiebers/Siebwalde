{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "project-lead",
  "subagent_depth": 1,
  "mcp": {
    "picoscope": {
      "type": "local",
      "command": [
        "C:\\Localdata\\Siebwalde\\tools\\picoscope\\.venv\\Scripts\\python.exe",
        "-m",
        "tools.picoscope.mcp"
      ],
      "cwd": "C:\\Localdata\\Siebwalde",
      "enabled": true,
      "environment": {
        "PICOSCOPE_EVIDENCE_DIR": "C:\\Localdata\\Siebwalde\\tools\\picoscope\\evidence\\mcp"
      },
      "timeout": 15000
    },
    "knowledge": {
      "type": "local",
      "command": [
        "C:\\Localdata\\Siebwalde\\tools\\knowledge\\.venv\\Scripts\\python.exe",
        "-m",
        "tools.knowledge.mcp_server"
      ],
      "cwd": "C:\\Localdata\\Siebwalde",
      "enabled": true,
      "environment": {
        "SIEBWALDE_KNOWLEDGE_DB": "C:\\Localdata\\Siebwalde\\tools\\knowledge\\db\\siebwalde-knowledge.lbdb",
        "LBUG_C_API_LIB_PATH": "C:\\Localdata\\Siebwalde\\tools\\knowledge\\lib\\lbug_shared.dll"
      },
      "timeout": 15000
    },
    "diagnostics": {
      "type": "local",
      "command": [
        "C:\\Localdata\\Siebwalde\\tools\\knowledge\\.venv\\Scripts\\python.exe",
        "-m",
        "tools.diagnostics.mcp_server"
      ],
      "cwd": "C:\\Localdata\\Siebwalde",
      "enabled": true,
      "timeout": 15000
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": {
      "*": "deny",
      "developer": "allow",
      "architect": "allow",
      "integrator": "allow",
      "designer": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*--force*": "ask",
      "git push* -f*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git filter-branch*": "ask",
      "git filter-repo*": "ask",
      "git rebase -i*": "ask",
      "git branch -D*": "ask"
    }
  }
}
