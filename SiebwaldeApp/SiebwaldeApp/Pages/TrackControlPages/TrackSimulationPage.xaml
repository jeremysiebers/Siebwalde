<local:BasePage x:TypeArguments="local:TrackSimulationPageViewModel"
                x:Class="SiebwaldeApp.TrackSimulationPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:SiebwaldeApp"
                mc:Ignorable="d"
                d:DesignHeight="803"
                d:DesignWidth="1920"
                Title="TrackSimulationPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Background="#FF101010" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: status + sections + controls -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Simulation" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />

                <!-- Profile selector: the operator chooses the layout profile to run FullSimulation
                     against. The list comes from the repository profile files, never from WPF code. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Profile" Foreground="LightGray" FontSize="12" VerticalAlignment="Center" Width="70" />
                    <ComboBox ItemsSource="{Binding AvailableProfiles}"
                              SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                              MinWidth="180" FontSize="12" />
                </StackPanel>

                <TextBlock Foreground="LightGray" FontSize="12">
                    <Run Text="Active profile: " /><Run Text="{Binding ProfileName}" FontWeight="Bold" Foreground="White" />
                </TextBlock>
                <TextBlock Foreground="LightGray" FontSize="12">
                    <Run Text="Runtime state: " /><Run Text="{Binding RuntimeState}" FontWeight="Bold" Foreground="White" />
                </TextBlock>
                <TextBlock Foreground="LightGray" FontSize="12">
                    <Run Text="Movement permission: " /><Run Text="{Binding MovementPermission}" FontWeight="Bold" Foreground="White" />
                </TextBlock>
                <TextBlock Foreground="LightGray" FontSize="12">
                    <Run Text="Active ECoS mode: " /><Run Text="{Binding ActiveMode}" FontWeight="Bold" Foreground="White" />
                </TextBlock>
                <TextBlock Foreground="LightGray" FontSize="12">
                    <Run Text="Detected slaves: " /><Run Text="{Binding DetectedSlaves}" FontWeight="Bold" Foreground="White" />
                </TextBlock>
                <TextBlock Foreground="LightGray" FontSize="12">
                    <Run Text="Movement simulator: " /><Run Text="{Binding MovementSimulationAvailable}" FontWeight="Bold" Foreground="White" />
                </TextBlock>

                <TextBlock Text="Sections" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,16,0,4" />
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="6" CornerRadius="4" Background="#FF202020" BorderBrush="DarkGray" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="White" FontSize="12" VerticalAlignment="Center"
                                               Text="{Binding SlaveNumber, StringFormat='Slave {0}'}" Width="60" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="LightGray" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="Occ" Foreground="LightGray" FontSize="10"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding SimulateOccupancy, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Controls" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,16,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Place loco" Foreground="LightGray" FontSize="11" VerticalAlignment="Center" Width="70" />
                    <TextBox Text="{Binding PlaceAddress, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" FontSize="11" />
                    <TextBox Text="{Binding PlaceBlock, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,4,0" FontSize="11" />
                    <Button Content="Place" Command="{Binding PlaceLocoCommand}" Padding="8,2" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Drive loco" Foreground="LightGray" FontSize="11" VerticalAlignment="Center" Width="70" />
                    <TextBox Text="{Binding DriveAddress, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" FontSize="11" />
                    <TextBox Text="{Binding DriveSpeed, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,4,0" FontSize="11" />
                    <Button Content="Drive" Command="{Binding DriveLocoCommand}" Padding="8,2" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Stop all" Command="{Binding StopAllCommand}" Padding="8,2" FontSize="11" />
                </StackPanel>
            </StackPanel>

            <!-- Right column: loco positions -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Locomotives" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Locos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="6" CornerRadius="4" Background="#FF202020" BorderBrush="DarkGray" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Address, StringFormat='Loco {0}'}" Foreground="White" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Summary}" Foreground="LightGray" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:BasePage>
