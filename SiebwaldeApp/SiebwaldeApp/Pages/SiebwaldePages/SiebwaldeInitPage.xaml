<local:BasePage x:TypeArguments="local:SiebwaldeInitPageViewModel" x:Class="SiebwaldeApp.SiebwaldeInitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SiebwaldeApp"
      mc:Ignorable="d" 
      d:DesignHeight="803" d:DesignWidth="1920"
      Title="SiebwaldeInitPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="900"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <GroupBox Margin="50 50 0 50" Foreground="{StaticResource BackgroundLightBrush}">
                <StackPanel>

                    <!-- Detect hosts row -->
                    <Grid Margin="0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Height="60"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DetectHosts}"
                            Foreground="White"
                            Content="Detect hosts" />

                        <TextBlock
                            Grid.Column="3"
                            FontSize="{StaticResource FontSizeXXLarge}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Run Text="Scan for FiddleYard, TrackController and Koploper."
                                 FontFamily="{StaticResource FontAwesome}"
                                 Foreground="{StaticResource ForegroundLightBrush}" />
                        </TextBlock>
                    </Grid>

                    <!-- TrackController row -->
                    <Grid Margin="0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Height="60"
                            HorizontalAlignment="Stretch"
                            Command="{Binding InitTrackController}"
                            IsEnabled="{Binding TrackControllerPresent}"
                            Foreground="White"
                            Content="Start TrackController" />

                        <TextBlock
                            Grid.Column="3"
                            FontSize="{StaticResource FontSizeXXLarge}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap">
                            <Run Text="{Binding TrackControllerStatus, Mode=OneWay}"
                                 FontFamily="{StaticResource FontAwesome}"
                                 Foreground="{StaticResource ForegroundLightBrush}" />
                        </TextBlock>
                    </Grid>

                    <!-- FiddleYard row -->
                    <Grid Margin="0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Height="60"
                            HorizontalAlignment="Stretch"
                            Command="{Binding InitFiddleYardController}"
                            IsEnabled="{Binding FiddleYardPresent}"
                            Foreground="White"
                            Content="Start FiddleYard" />

                        <Button
                            Grid.Column="3"
                            Height="60"
                            HorizontalAlignment="Stretch"
                            Command="{Binding InitFiddleYardSimulator}"
                            Foreground="White"
                            Content="FiddleYard simulator" />

                        <TextBlock
                            Grid.Column="5"
                            FontSize="{StaticResource FontSizeXXLarge}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap">
                            <Run Text="{Binding FiddleYardStatus, Mode=OneWay}"
                                 FontFamily="{StaticResource FontAwesome}"
                                 Foreground="{StaticResource ForegroundLightBrush}" />
                        </TextBlock>
                    </Grid>

                    <!-- Koploper row -->
                    <Grid Margin="0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="{StaticResource FontSizeXXLarge}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Run Text="Koploper"
                                 FontFamily="{StaticResource FontAwesome}"
                                 Foreground="{StaticResource ForegroundLightBrush}" />
                        </TextBlock>

                        <TextBlock
                            Grid.Column="3"
                            FontSize="{StaticResource FontSizeXXLarge}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap">
                            <Run Text="{Binding KoploperStatus, Mode=OneWay}"
                                 FontFamily="{StaticResource FontAwesome}"
                                 Foreground="{StaticResource ForegroundLightBrush}" />
                        </TextBlock>
                    </Grid>

                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Logging TextBlock -->
        <Grid Grid.Column="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <ListBox
                x:Name="TextBoxLogging"
                Grid.Column="1"
                Margin="50 50 50 10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                TextElement.FontFamily="{StaticResource FontAwesome}"
                FontFamily="{StaticResource FontAwesome}"
                FontSize="{StaticResource FontSizeRegular}"
                Background="{StaticResource TextBoxBackgroundBrush}"
                Foreground="{StaticResource BackgroundLightBrush}"
                ItemsSource="{Binding Path=Log2}"
                />

            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                FontSize="{StaticResource FontSizeXXLarge}"
                Margin="50 0 0 0 ">
                <Run Text="Logging"
                     FontFamily="{StaticResource FontAwesome}"
                     Foreground="{StaticResource BackgroundLightBrush}" />
            </TextBlock>
        </Grid>

    </Grid>
</local:BasePage>
