<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Circular host status indicator used on the initialization page.
        The Fill is expected to be supplied by the caller, for example through a
        MultiBinding on HostStatusBrushConverter: green = present, amber = checking,
        gray = absent/unknown.
    -->
    <Style x:Key="HostStatusDot" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0 0 12 0" />
    </Style>

</ResourceDictionary>
